{
  "name": "@videooverview/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Video Overview API - Next.js client library",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "video-generation",
    "ai",
    "sdk",
    "typescript",
    "next.js"
  ],
  "author": "Video Overview",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesOptional": {
    "react": true
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
