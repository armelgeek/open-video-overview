# Mammouth AI API Key (texte + images, OpenAI-compatible)
# https://mammouth.ai
MAMMOUTH_API_KEY=your_mammouth_api_key

# Optionnel : surcharge des modèles
# MAMMOUTH_TEXT_MODEL=gemini-3.1-pro-preview
# MAMMOUTH_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ElevenLabs API Key (narration)
# https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optionnel : voix (defaut "George", utilisable en plan gratuit)
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
